{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/posters",
      "destination": "/posters.html"
    },
    {
      "source": "/lead-ads",
      "destination": "/lead-ads.html"
    },
    {
      "source": "/uiux",
      "destination": "/uiux.html"
    },
    {
      "source": "/branding",
      "destination": "/branding.html"
    },
    {
      "source": "/project-view",
      "destination": "/project-view.html"
    }
  ]
}
